# Copy this file to .env and fill in your values.
# You can also pass SHEET_ID with --sheet=... on the command line.

# Google service account JSON key (whole JSON on one line), OR a file path below.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Default sheet + tab (overridden by --sheet / --tab flags)
SHEET_ID=
SHEET_TAB=Websites

# Extraction tuning
EXTRACT_CONCURRENCY=5
BATCH_PAUSE_EVERY=100
BATCH_PAUSE_MS=90000

# Verification tuning
VERIFY_FROM=verify@rankvelt.com
VERIFY_HELO=rankvelt.com
SMTP_CONCURRENCY=3
